{{- if eq .chezmoi.osRelease.id "arch" }}
#!/usr/bin/env bash
set -euo pipefail

# packageList.arch.txt hash: {{ include "packageList.arch.txt" | sha256sum }}
# This script is rendered and run only on Arch Linux.

echo "Checking for missing packages..."

# Read the list and install missing packages
# Using --needed to skip already installed ones
MISSING_PACKAGES=$(comm -23 \
    <(sort {{ .chezmoi.sourceDir | quote }}/packageList.arch.txt) \
    <(paru -Qq | sort))

if [ -n "$MISSING_PACKAGES" ]; then
    echo "Installing: $MISSING_PACKAGES"
    # Note: Requires sudo or to be run as root
    paru -S --needed --noconfirm $MISSING_PACKAGES
else
    echo "All packages are already installed."
fi
{{- end }}
