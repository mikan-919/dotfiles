# NixOS が入れる helix の実行ファイル名は hx。helix という名前のバイナリは無い。
export EDITOR=hx
export VISUAL=$EDITOR

# The NixOS-generated /etc/zshrc duplicates completion and prompt setup from
# the user configuration. /etc/zshenv is still loaded, so Nix paths and fpath
# remain available.
setopt no_global_rcs

# cargo install で入れたコマンド（hibana など）。対話でないシェルも読む .zshenv に置き、Zed の WSL 側からも見つかるようにする。
[[ -d $HOME/.cargo/bin ]] && path=( $HOME/.cargo/bin $path )
